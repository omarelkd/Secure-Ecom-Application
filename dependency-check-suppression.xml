<?xml version="1.0" encoding="UTF-8"?>
<!--
Configuration de suppression des faux positifs Dependency-Check
À placer dans le répertoire racine du projet
Fichier : dependency-check-suppression.xml
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    Exemple de suppression : 
    
    <suppression>
        <notes>Raison de la suppression</notes>
        <gav regex="false">org.example:library:1.0.0</gav>
        <cve>CVE-XXXX-XXXXX</cve>
    </suppression>
    
    Options :
    - cve : CVE spécifique à supprimer
    - cpe : Suppression basée sur CPE
    - packageUrl : Suppression basée sur package URL
    - vulnerabilityName : Nom de la vulnérabilité
    -->

    <!-- Suppression des vulnérabilités connues/acceptées -->
    
    <!-- Exemple : Suppression d'une vulnérabilité faible dans une dépendance -->
    <!--
    <suppression>
        <notes>Vulnérabilité faible - risque accepté</notes>
        <gav regex="false">org.springframework:spring-web:5.3.0</gav>
        <cve>CVE-2021-XXXXX</cve>
    </suppression>
    -->

    <!-- Suppressions pour les dépendances de test (optionnel) -->
    <!--
    <suppression>
        <notes>Dépendance de test seulement</notes>
        <packageUrl regex="false">pkg:maven/junit/junit@4.13.2</packageUrl>
        <cve>CVE-XXXX-XXXXX</cve>
    </suppression>
    -->

</suppressions>
