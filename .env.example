# ============= Configuration Docker - OAuth2/OIDC Platform =============
# Copier ce fichier en .env et ajuster les valeurs selon vos besoins

# ============= KEYCLOAK =============
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=microservices-realm
KC_PROXY=edge
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_HOSTNAME_PORT=8080
KEYCLOAK_HOSTNAME_PROTOCOL=http

# ============= POSTGRESQL =============
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_password

# ============= SPRING BOOT PORTS =============
SERVER_PORT_PRODUCT=8081
SERVER_PORT_ORDER=8082
SERVER_PORT_GATEWAY=8085

# ============= REACT APP =============
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_API_URL=http://localhost:8085

# ============= JWT & OAUTH2 =============
ISSUER_URI=http://localhost:8080/realms/microservices-realm
JWT_ISSUER_URI=http://keycloak:8080/realms/microservices-realm

# ============= LOGGING =============
SPRING_LOGGING_LEVEL_ROOT=INFO
SPRING_LOGGING_LEVEL_SPRING_SECURITY=DEBUG
SPRING_LOGGING_LEVEL_MA_ENSET=DEBUG

# ============= DOCKER COMPOSE =============
COMPOSE_PROJECT_NAME=oauth2-oidc
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============= PRODUCTION SETTINGS (À décommenter pour la production) =============
# KEYCLOAK_HOSTNAME=yourdomain.com
# KEYCLOAK_HOSTNAME_PORT=443
# KEYCLOAK_HOSTNAME_PROTOCOL=https
# ALLOWED_ORIGINS=https://yourdomain.com
# POSTGRES_PASSWORD=your-very-secure-password
# KEYCLOAK_ADMIN_PASSWORD=your-very-secure-password
PRODUCT_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
GATEWAY_PORT=8085
REACT_APP_PORT=3000

# Configuration PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_password
POSTGRES_PORT=5432

# Configuration React
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_REALM=microservices-realm
REACT_APP_CLIENT_ID=react-client
REACT_APP_API_URL=http://localhost:8085

# Utilisateurs de Test
TEST_USER_USERNAME=john.user
TEST_USER_PASSWORD=password123
TEST_ADMIN_USERNAME=alice.admin
TEST_ADMIN_PASSWORD=admin123
TEST_MANAGER_USERNAME=bob.manager
TEST_MANAGER_PASSWORD=manager123

# Clients OAuth2
REACT_CLIENT_ID=react-client
GATEWAY_CLIENT_ID=gateway-client
PRODUCT_SERVICE_CLIENT_ID=product-service
ORDER_SERVICE_CLIENT_ID=order-service

# Rôles
ROLE_USER=user
ROLE_ADMIN=admin
ROLE_MANAGER=manager

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug
